@model Handball4RO.Models.CautareViewModel

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0 p-4 text-center bg-dark text-white mb-4">
        <h2 class="fw-bold text-info mb-3">🔍 Căutare Globală</h2>
        <form asp-action="Index" method="get" class="row justify-content-center">
            <div class="col-md-8 d-flex gap-2">
                <input type="text" name="query" value="@Model.TextCautat" class="form-control form-control-lg" placeholder="Caută un jucător sau o echipă..." required />
                <button type="submit" class="btn btn-info fw-bold btn-lg">Caută</button>
            </div>
        </form>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.TextCautat))
    {
        <h4 class="fw-bold text-muted mb-4">Rezultate pentru: "<span class="text-primary">@Model.TextCautat</span>"</h4>

        <div class="row">
            <div class="col-md-6 mb-4">
                <h5 class="fw-bold text-primary border-bottom pb-2">🛡️ Echipe Găsite (@Model.EchipeGasite.Count)</h5>
                @if (Model.EchipeGasite.Any())
                {
                    <div class="list-group shadow-sm">
                        @foreach (var e in Model.EchipeGasite)
                        {
                            <a asp-controller="Jucatori" asp-action="Index" asp-route-echipaId="@e.Id" class="list-group-item list-group-item-action d-flex align-items-center">
                                <img src="@e.LogoUrl" style="width: 40px; height: 40px; object-fit: contain;" class="me-3" onerror="this.src='https://cdn-icons-png.flaticon.com/512/1000/1000884.png'" />
                                <span class="fw-bold fs-5">@e.Nume</span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary text-center">Nu a fost găsită nicio echipă.</div>
                }
            </div>

            <div class="col-md-6">
                <h5 class="fw-bold text-success border-bottom pb-2">🏃‍♂️ Jucători Găsiți (@Model.JucatoriGasiti.Count)</h5>
                @if (Model.JucatoriGasiti.Any())
                {
                    <div class="list-group shadow-sm">
                        @foreach (var j in Model.JucatoriGasiti)
                        {
                            <a asp-controller="Jucatori" asp-action="Index" asp-route-echipaId="@j.EchipaId" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold fs-5">@j.Nume</span> <br />
                                    <small class="text-muted">Vezi lotul echipei sale</small>
                                </div>
                                <span class="badge bg-light text-dark fs-6">@j.Pozitie</span>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary text-center">Nu a fost găsit niciun jucător.</div>
                }
            </div>
        </div>
    }
</div>