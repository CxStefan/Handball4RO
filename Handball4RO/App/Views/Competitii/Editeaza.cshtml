@model Handball4RO.Models.Competitie

<div class="row justify-content-center mt-5">
    <div class="col-md-6 card p-4 shadow-sm border-0">
        <h3 class="fw-bold mb-4">Editează Competiția</h3>

        <form asp-action="Editeaza" method="post">
            <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Nume" class="form-label fw-bold">Numele Competiției</label>
                <input asp-for="Nume" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Sezon" class="form-label fw-bold">Sezon (ex: 2023-2024)</label>
                <input asp-for="Sezon" class="form-control" required />
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-warning fw-bold px-4">Salvează Modificările</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Anulează</a>
            </div>
        </form>
    </div>
</div>