@model Handball4RO.Models.Echipa

@{
    ViewData["Title"] = "Adaugă Echipă Nouă";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 card p-4 shadow-sm border-0">
        <h3 class="fw-bold mb-4 text-primary">Adaugă Echipă Nouă în Sistem</h3>

        <form asp-action="Adauga" method="post">
            <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

            <input type="hidden" name="competitieId" value="@ViewBag.CompetitieId" />

            <div class="mb-3">
                <label asp-for="Nume" class="form-label fw-bold">Numele Echipei</label>
                <input asp-for="Nume" class="form-control" placeholder="ex: CSM Constanța" required />
                <span asp-validation-for="Nume" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Oras" class="form-label fw-bold">Orașul Echipei</label>
                <input asp-for="Oras" class="form-control" placeholder="ex: Constanța" required />
                <span asp-validation-for="Oras" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="LogoUrl" class="form-label fw-bold">Link Logo (Opțional)</label>
                <input asp-for="LogoUrl" class="form-control" placeholder="https://link-imagine.ro/logo.png" />
                <small class="text-muted">Aici poți pune adresa de pe internet a unei poze cu sigla.</small>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary fw-bold px-4">✔ Salvează Echipa</button>

                <a asp-action="Index" asp-route-competitieId="@ViewBag.CompetitieId" class="btn btn-outline-secondary">
                    Anulează și Întoarce-te
                </a>
            </div>
        </form>
    </div>
</div>