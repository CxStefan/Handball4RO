@model IEnumerable<Handball4RO.Models.Echipa>

@{
    ViewData["Title"] = "Gestiune Echipe";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">🛡️ Echipe Handball4RO</h2>
        <a asp-action="Adauga" class="btn btn-primary fw-bold">+ Adaugă Echipă Nouă</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;">Logo</th>
                        <th>Nume Echipă</th>
                        <th>Oraș</th>
                        <th class="text-end">Acțiuni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle">
                                <img src="@item.LogoUrl" alt="Logo" style="width: 40px; height: 40px; object-fit: contain;"
                                     onerror="this.src='https://cdn-icons-png.flaticon.com/512/1000/1000884.png'" />
                            </td>
                            <td class="fw-bold align-middle">@item.Nume</td>
                            <td class="align-middle text-muted">@item.Oras</td>
                            <td class="text-end align-middle">
                                <a asp-action="Editeaza" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">✏️</a>
                                <a asp-action="Sterge" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">🗑️</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center p-4 text-muted">
                                Nu există echipe în sistem. Apasă pe butonul de mai sus pentru a adăuga prima echipă!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>