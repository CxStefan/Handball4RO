@model IEnumerable<Handball4RO.Models.Echipa>

@{
    ViewData["Title"] = "Gestiune Echipe";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            @(ViewBag.CompetitieId != null ? "🛡️ Echipe din Competiție" : "🛡️ Toate Echipele Handball4RO")
        </h2>

        <div>
            @if (ViewBag.CompetitieId != null)
            {
                <a asp-controller="Competitii" asp-action="Details" asp-route-id="@ViewBag.CompetitieId" class="btn btn-dark fw-bold me-2">
                    ← Înapoi la Clasament
                </a>
            }

            <a asp-action="Adauga" asp-route-competitieId="@ViewBag.CompetitieId" class="btn btn-primary fw-bold">+ Adaugă Echipă Nouă</a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;" class="ps-3">Logo</th>
                        <th>Nume Echipă</th>
                        <th>Oraș</th>
                        <th class="text-end pe-4">Acțiuni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle ps-3">
                                <img src="@item.LogoUrl" alt="Logo" style="width: 40px; height: 40px; object-fit: contain;"
                                     onerror="this.src='https://cdn-icons-png.flaticon.com/512/1000/1000884.png'" />
                            </td>
                            <td class="fw-bold align-middle">@item.Nume</td>
                            <td class="align-middle text-muted">@item.Oras</td>
                            <td class="text-end align-middle pe-4">
                                <a asp-action="Editeaza" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning fw-bold">✏️ Editează</a>
                                <a asp-action="Sterge" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger fw-bold ms-1">🗑️ Șterge</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center p-5 text-muted">
                                <span class="fs-4 d-block mb-2">🤷‍♂️</span>
                                Nu există echipe adăugate încă.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>