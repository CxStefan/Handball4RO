@model IEnumerable<Handball4RO.Models.Clasament>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">📊 Clasament @ViewBag.NumeCompetitie</h2>

        <div class="d-flex gap-2 flex-wrap">
            @if (User.IsInRole("Admin"))
            {
              <a asp-controller="Echipe" asp-action="Index" asp-route-competitieId="@Context.Request.RouteValues["id"]" class="btn btn-outline-dark fw-bold">
                    🔍 Afișează Echipele din Ligă
              </a>
            }

            <a asp-controller="Meciuri" asp-action="Index" asp-route-competitieId="@Context.Request.RouteValues["id"]" class="btn btn-warning fw-bold text-dark">
                🗓️ Calendar Meciuri
            </a>

			@if (User.IsInRole("Admin"))
            {
                <a asp-controller="Clasament" asp-action="AdaugaInCompetitie" asp-route-competitieId="@Context.Request.RouteValues["id"]" class="btn btn-success fw-bold">
                    + Adaugă în Clasament
                </a>
            }
        </div>
    </div>

    <table class="table table-bordered bg-white shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Echipă</th>
                <th>M</th>
                <th>V</th>
                <th>E</th>
                <th>Î</th>
                <th>GM-GP</th>
                <th>PCT</th>
                @if (User.IsInRole("Admin"))
                {
                    <th>Acțiuni</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var rand in Model)
            {
                <tr>
                    <td>
                        <a asp-controller="Jucatori" asp-action="Index" asp-route-echipaId="@rand.EchipaId" asp-route-competitieId="@rand.CompetitieId" class="fw-bold text-decoration-none text-primary">
                            @rand.Echipa?.Nume
                        </a>
                    </td>
                    <td>@rand.MeciuriJucate</td>
                    <td>@rand.Victorii</td>
                    <td>@rand.Egaluri</td>
                    <td>@rand.Infrangeri</td>
                    <td>@rand.GoluriMarcate - @rand.GoluriPrimite</td>
                    <td class="fw-bold text-primary">@rand.Puncte</td>
                    @if (User.IsInRole("Admin"))
                    {
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-controller="Clasament" asp-action="Editeaza" asp-route-id="@rand.Id" class="btn btn-sm btn-warning">✏️</a>

                                <form asp-controller="Clasament" asp-action="Sterge" method="post" onsubmit="return confirm('Scoți echipa din competiție?')">
                                    <input type="hidden" name="id" value="@rand.Id" />
                                    <input type="hidden" name="competitieId" value="@rand.CompetitieId" />
                                    <button type="submit" class="btn btn-sm btn-danger">🗑️</button>
                                </form>
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>