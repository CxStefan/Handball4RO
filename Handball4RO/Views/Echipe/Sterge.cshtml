@model Handball4RO.Models.Echipa

<div class="container mt-5">
    <div class="alert alert-danger shadow">
        <h3>⚠️ Atenție!</h3>
        <p>Ești sigur că vrei să ștergi echipa <strong>@Model.Nume</strong>?</p>
        <p class="small text-muted">Această acțiune va șterge echipa și din toate clasamentele în care apare.</p>

        <form asp-action="Sterge">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger fw-bold">Da, Șterge Definitiv</button>
            <a asp-action="Index" class="btn btn-secondary">Anulează</a>
        </form>
    </div>
</div>