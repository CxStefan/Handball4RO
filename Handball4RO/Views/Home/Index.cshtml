@{
    ViewData["Title"] = "Home Page";
}

<div class="row align-items-center rounded-3 bg-light p-5 shadow-sm">
    <div class="col-lg-7 text-center text-lg-start">
        <h1 class="display-4 fw-bold lh-1 mb-3">Totul despre handbalul din România</h1>
        <p class="lead">
            Urmărește competițiile, află rezultatele în timp real și susține-ți echipa favorită.
            Platformă dedicată juniorilor și seniorilor pasionați de handbal.
        </p>
        <div class="d-grid gap-2 d-md-flex justify-content-md-start">
            <a asp-controller="Competitii" asp-action="Index" class="btn btn-primary btn-lg px-4 me-md-2">Vezi Competițiile</a>
        </div>
    </div>
    <div class="col-lg-5 d-none d-lg-block">
        <img src="images/handball4ro.jpeg
                " class="img-fluid rounded shadow" alt="Jucator de handbal">
    </div>
</div>
