@model Handball4RO.Models.ProfilViewModel

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow border-0 p-4">
            <h4 class="fw-bold text-warning mb-4 text-center">✏️ Personalizează Profilul</h4>

            <form asp-action="Editeaza" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Numele tău complet sau porecla</label>
                    <input asp-for="NumeComplet" class="form-control" placeholder="ex: Ion Popescu" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Link Poza de Profil (URL)</label>
                    <input asp-for="PozaProfilUrl" class="form-control" placeholder="https://..." />
                    <small class="text-muted">Lipește aici un link către o imagine de pe internet.</small>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary fw-bold">💾 Salvează Modificările</button>
                    <a asp-action="Index" class="btn btn-outline-secondary fw-bold">Anulează</a>
                </div>
            </form>
        </div>
    </div>
</div>
