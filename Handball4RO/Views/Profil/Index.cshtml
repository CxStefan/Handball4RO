@model Handball4RO.Models.ApplicationUser

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 mb-4">
            <div class="card shadow border-0 text-center p-4">
                <img src="@(string.IsNullOrEmpty(Model.PozaProfilUrl) ? "https://cdn-icons-png.flaticon.com/512/149/149071.png" : Model.PozaProfilUrl)"
                     class="rounded-circle mx-auto mb-3 shadow"
                     style="width: 150px; height: 150px; object-fit: cover;" alt="Profil" />

                <h3 class="fw-bold text-primary mb-1">
                    @(string.IsNullOrEmpty(Model.NumeComplet) ? "Fan Handbal" : Model.NumeComplet)
                </h3>
                <p class="text-muted mb-4">@Model.Email</p>
                <a asp-action="Editeaza" class="btn btn-warning fw-bold px-4 py-2 w-100">✏️ Editează Profilul</a>

                @if (User.IsInRole("Admin"))
                {
                    <hr class="mt-4 mb-3" />
                    <h5 class="fw-bold text-danger text-center">Panou Administrator</h5>
                    <a asp-controller="Utilizatori" asp-action="Index" class="btn btn-danger fw-bold px-4 py-2 w-100 shadow-sm">
                        🛡️ Gestionează Utilizatorii
                    </a>
                }
            </div>
        </div>
    </div>
</div>