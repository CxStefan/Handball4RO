<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Handball4RO</title>
    <link rel="icon" href="~/images/handball4ROLogo.svg" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/styles/style.css">
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Handball&#x34;&#xFE0F;&#x20E3;RO</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarPrincipal"
                    aria-controls="navbarPrincipal" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarPrincipal">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-4">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Acasă</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Stiri" asp-action="Index">Știri</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Competitii" asp-action="Index">Competiții</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Statistici" asp-action="Index">Statistici</a> </li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Astazi" asp-action="Index">Astăzi 📅</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Cautare" asp-action="Index">Căutare 🔍</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Contact" asp-action="Index">Contact</a></li>
                </ul>

                <div class="d-flex align-items-center ms-lg-4">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Profil" asp-action="Index" class="btn btn-sm btn-outline-warning me-2 fw-bold">
                            Profilul Meu
                        </a>
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-sm btn-danger fw-bold">
                            Ieși din cont
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-light me-2 fw-bold">
                            Login
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary fw-bold">
                            Sign up
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div class="container mt-5 mb-5">
        @RenderBody()
    </div>

    <footer class="container mt-5 py-3 border-top text-center text-muted">
        <p>&copy; 2026 Handball4RO. Toate drepturile rezervate.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>