@model Handball4RO.Models.Stire

@{
    ViewData["Title"] = "Adaugă Știre Nouă";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 p-4">
            <h3 class="fw-bold mb-4">Adaugă un articol nou</h3>

            <form asp-action="Adauga" method="post">

                <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Titlu" class="form-label fw-bold">Titlu Știre</label>
                    <input asp-for="Titlu" class="form-control" required />
                    <span asp-validation-for="Titlu" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImagineUrl" class="form-label fw-bold">Link Imagine (URL)</label>
                    <input asp-for="ImagineUrl" class="form-control" placeholder="Ex: https://site.ro/imagine.jpg" />
                </div>

                <div class="mb-3">
                    <label asp-for="Continut" class="form-label fw-bold">Conținut Articol</label>
                    <textarea asp-for="Continut" class="form-control" rows="6" required></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success fw-bold">Publică Articolul</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Anulează</a>
                </div>
            </form>
        </div>
    </div>
</div>