@model Handball4RO.Models.Stire

@{
    ViewData["Title"] = "Editează Știrea";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 p-4">
            <h3 class="fw-bold mb-4">Editează Articolul</h3>

            <form asp-action="Editeaza" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="DataPublicare" />
                <input type="hidden" asp-for="ImagineUrl" />

                <div class="mb-3">
                    <label asp-for="Titlu" class="form-label fw-bold">Titlu Știre</label>
                    <input asp-for="Titlu" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Schimbă Imaginea (opțional)</label>
                    <input type="file" name="fisierPoza" class="form-control" accept="image/*" />
                    <small class="text-muted">Alege o poză nouă doar dacă vrei să o înlocuiești pe cea curentă.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Continut" class="form-label fw-bold">Conținut Articol</label>
                    <textarea asp-for="Continut" class="form-control" rows="6" required></textarea>
                </div>

                <button type="submit" class="btn btn-warning fw-bold">Salvează Modificările</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Anulează</a>
            </form>
        </div>
    </div>
</div>